# ====== 应用 ======
NODE_ENV=development
APP_URL=http://localhost:3000
PUBLIC_SITE_NAME="财芽 CaiYa"

# ====== 数据库（PostgreSQL） ======
# 本地开发：docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres pgvector/pgvector:pg16
# 生产：Neon / Supabase / 阿里云 RDS
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicaiwu?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/aicaiwu?schema=public

# ====== Auth.js (NextAuth v5) ======
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# 邮箱登录（开发用 Resend / Mailgun / 自建 SMTP 二选一）
EMAIL_FROM="财芽 CaiYa <no-reply@aicaiwu.cn>"
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# 手机号验证码
SMS_PROVIDER=aliyun        # aliyun / tencent / mock
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME="财芽 CaiYa"
SMS_TEMPLATE_CODE=

# 微信扫码登录（开放平台 / 公众平台 二选一）
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=

# ====== 支付 ======
# 微信支付 V3
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_PRIVATE_KEY_PATH=./secrets/wxpay_apiclient_key.pem
WXPAY_CERT_SERIAL_NO=
WXPAY_NOTIFY_URL=https://aicaiwu.cn/api/payment/wxpay/notify

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=./secrets/alipay_app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=./secrets/alipay_public_key.pem
ALIPAY_NOTIFY_URL=https://aicaiwu.cn/api/payment/alipay/notify
ALIPAY_RETURN_URL=https://aicaiwu.cn/account/orders

# ====== AI（OpenAI 兼容） ======
# 默认走 DeepSeek（国内可访问），可换成通义千问 / 智谱 GLM / OpenAI
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_EMBED_MODEL=text-embedding-3-small
AI_DAILY_QUOTA_FREE=20
AI_DAILY_QUOTA_PRO=2000

# ====== 对象存储 ======
OSS_PROVIDER=aliyun
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=aicaiwu-public
OSS_REGION=oss-cn-hangzhou
OSS_CDN_DOMAIN=cdn.aicaiwu.cn

# ====== 可观测 ======
SENTRY_DSN=
PLAUSIBLE_DOMAIN=aicaiwu.cn
PLAUSIBLE_API_HOST=https://plausible.io

# ====== 邮件订阅（Resend / 自建 SMTP） ======
NEWSLETTER_PROVIDER=resend
RESEND_API_KEY=

# ====== 功能开关 ======
FEATURE_AI_CHAT=true
FEATURE_PAYMENT=true
FEATURE_ADMIN_PANEL=false
